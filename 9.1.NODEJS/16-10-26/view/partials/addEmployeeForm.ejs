<div class="bg-white p-6 rounded-lg shadow mb-6">
  <h3 class="text-xl font-bold mb-4">Add Employee</h3>
  <form id="employeeForm" class="grid gap-4 md:grid-cols-2">
    <input type="hidden" id="employeeId">
    <input id="empName" type="text" placeholder="Employee Name"
      class="border border-gray-300 rounded-lg p-2.5" required>
    <input id="empEmail" type="email" placeholder="Email"
      class="border border-gray-300 rounded-lg p-2.5" required>
    <input id="empCity" type="text" placeholder="City"
      class="border border-gray-300 rounded-lg p-2.5" required>
    <select id="empGender" class="border border-gray-300 rounded-lg p-2.5" required>
      <option value="">Select Gender</option><option>Male</option><option>Female</option><option>Other</option>
    </select>
    <button type="submit" class="md:col-span-2 text-white bg-blue-700 hover:bg-blue-800 rounded-lg px-5 py-2.5">
      Save Employee
    </button>
  </form>
</div>